# ------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA versione o arquivo .env (ele já está no .gitignore).
# ------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# Endereço em que a API escuta. Mantenha 127.0.0.1 (só esta máquina) também em produção,
# com o proxy reverso (Caddy/Nginx) na mesma máquina recebendo os acessos da rede.
HOST=127.0.0.1
PORT=3333

# Origem permitida do frontend (usada na proteção contra CSRF).
# Desenvolvimento: http://localhost:5173  |  Produção: https://salas.suaempresa.local
# Em produção é obrigatório https:// (o cookie de sessão só trafega com HTTPS).
APP_ORIGIN=http://localhost:5173

# Proxy reverso confiável, para ler o IP real do usuário (cabeçalho X-Forwarded-For):
#   false     sem proxy (padrão)
#   loopback  proxy na mesma máquina (o recomendado com HOST=127.0.0.1)
#   1         um proxy na frente da API, em outra máquina
#   10.0.0.5  IP (ou faixa, ex.: 10.0.0.0/24) do proxy; vários separados por vírgula
# Atrás de um proxy com "false", todos parecem vir do mesmo IP e o limite de tentativas
# de login passa a valer para a empresa inteira. "true" não é aceito (permitiria forjar o IP).
TRUST_PROXY=false

# Nível de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ------------------------------------------------------------------
# Banco de dados (Supabase)
# No painel do projeto: botão "Connect" > "Session pooler" > copie a URI.
# Troque SUA-SENHA pela senha do banco. Se a senha tiver caracteres especiais
# (@ : / ? # % etc.), gere uma só com letras e números ou codifique-a.
# ------------------------------------------------------------------

# Projeto PRINCIPAL (dados reais do sistema).
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# OPCIONAL (recomendado em produção). Se DATABASE_URL usar o usuário de permissões mínimas
# "reserva_app" (veja docs/BANCO.md), informe aqui a URL com o usuário "postgres" do MESMO
# projeto: ela é usada só por db:setup, db:migrate e db:restaurar, nunca pelo servidor.
# DATABASE_MIGRATION_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Projeto SEPARADO só para os testes automáticos (eles apagam e recriam dados).
DATABASE_URL_TEST=postgresql://postgres.SEU-PROJETO-DE-TESTE:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# SSL da conexão:
#   require     -> criptografa (bom para começar em desenvolvimento)
#   verify-full -> criptografa e confere o certificado do Supabase (OBRIGATÓRIO em produção)
DATABASE_SSL=require

# Certificado do Supabase (usado com verify-full). Caminho relativo à raiz do projeto.
# Painel: Database > Settings > SSL Configuration > Download certificate.
# DATABASE_SSL_CA=certs/supabase-ca.crt

# Máximo de conexões simultâneas da API (o plano gratuito tem limite baixo).
DATABASE_POOL_MAX=5

# Tempo máximo (ms) para abrir uma conexão com o banco.
DATABASE_CONNECTION_TIMEOUT_MS=8000

# ------------------------------------------------------------------
# Sessão e login
# ------------------------------------------------------------------
# Encerra a sessão após este tempo SEM USO (minutos).
SESSION_IDLE_MINUTES=480
# Encerra a sessão após este tempo desde o login, mesmo em uso (horas).
SESSION_MAX_HOURS=12
# Tentativas de login por minuto, por endereço IP.
LOGIN_RATE_LIMIT_MAX=10
# Requisições à API por minuto, por endereço IP (os arquivos do site não contam).
# Um usuário com o sistema aberto faz cerca de 10 por minuto.
RATE_LIMIT_MAX=600
