# ------------------------------------------------------------------
# Exemplo de .env para o SERVIDOR da rede interna (docs/IMPLANTACAO.md).
# Copie para ".env" na raiz do projeto, no servidor, e preencha.
# Nunca envie este arquivo preenchido por e-mail nem o coloque em pastas compartilhadas.
# ------------------------------------------------------------------

NODE_ENV=production

# A API escuta só nesta máquina; o Caddy (mesma máquina) recebe os acessos da rede.
HOST=127.0.0.1
PORT=3333

# Endereço que as pessoas digitam no navegador. Deve ser o mesmo nome do Caddyfile.
APP_ORIGIN=https://salas.suaempresa.interno

# Caddy na mesma máquina.
TRUST_PROXY=loopback

# "warn": registra só avisos e erros. Com "info", cada acesso vira uma linha de log
# (dezenas de MB por dia com a empresa toda usando). O Caddy já registra os acessos
# (C:\caddy\logs, com rotação) e a auditoria registra quem fez o quê no sistema.
LOG_LEVEL=warn

# Servidor: usuário de permissões mínimas (docs/BANCO.md › Usuário da aplicação).
DATABASE_URL=postgresql://reserva_app.SEU-PROJETO:SUA-SENHA-DO-RESERVA-APP@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Usuário dono, só para db:migrate e db:restaurar.
DATABASE_MIGRATION_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA-DO-POSTGRES@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Obrigatório em produção: confere o certificado do Supabase.
DATABASE_SSL=verify-full
DATABASE_SSL_CA=certs/supabase-ca.crt

DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=8000

SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=12
LOGIN_RATE_LIMIT_MAX=30
RATE_LIMIT_MAX=600
